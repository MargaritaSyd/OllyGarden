# Public site origin used for canonical URLs, Open Graph, sitemap, and robots.
# Use your production domain in deployed environments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (publishable key only — never a secret/service_role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Inserts run without this. Set to true only when you want Edge Function emails.
NEXT_PUBLIC_SUPABASE_SEND_EMAIL=false
