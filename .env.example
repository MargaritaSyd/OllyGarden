# Public site origin used for canonical URLs, Open Graph, sitemap, and robots.
# Required on every deploy — no host-specific fallbacks.
# Omit or leave as localhost for local `next dev`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog — public browser SDK configuration.
# The token key is exact: NEXT_PUBLIC_POSTHOG_TOKEN is not read by the app.
# Deploys read these from GitHub repository variables.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Apollo website visitor tracker app ID (company-level identification, loaded only after
# analytics consent). Leave empty to disable.
NEXT_PUBLIC_APOLLO_APP_ID=

# HubSpot portal (hub) ID for the tracking code (loaded only after analytics consent).
# Leave empty to disable.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

# Supabase — server only. Do not prefix with NEXT_PUBLIC_.
# Never put a secret / service_role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Inserts run without this. Set to true only when you want Edge Function emails.
SUPABASE_SEND_EMAIL=false
