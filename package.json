{
  "name": "wicket",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prebuild": "node scripts/validate-netlify-env.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun run test:unit && bun run test:rss",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-include='scripts/**' 'test/*.test.mjs'",
    "test:rss": "NEXT_PUBLIC_SITE_URL=https://ollygarden.com next build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/build/rss.test.mjs",
    "supabase": "bunx supabase@2.120.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "next": "16.4.3",
    "posthog-js": "^1.430.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "schema-dts": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
